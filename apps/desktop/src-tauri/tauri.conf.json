{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stint",
  "version": "0.1.0",
  "identifier": "za.co.stint.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --filter @stint/web dev",
    "beforeBuildCommand": "bun run --filter @stint/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stint",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "publisher": "Stint",
    "category": "Productivity",
    "shortDescription": "Time tracking for firms that bill by the hour",
    "longDescription": "Stint is a self-hosted, local-first time tracker. The desktop app finds your office Stint Server by itself, keeps working offline and syncs when it can.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
